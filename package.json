{
  "name": "cheatlab",
  "version": "1.0.0",
  "private": true,
  "description": "CHEATLAB — анонимная публикация скриптов, паст и файлов. Без регистрации и входа.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
