# OpenAI-compatible client key accepted by the public hub
OPENAI_API_KEY=sk-replace-with-a-long-random-token

# Shared worker registration secret (32+ random bytes)
CLUSTER_SECRET=replace-with-at-least-32-random-bytes

# Admin password for /api/cluster/status and /api/cluster/scale-up
ADMIN_PASSWORD=replace-with-a-unique-long-password

# Public HTTPS URL of this FastAPI service
MASTER_PUBLIC_URL=https://api.cheatlab.fun

# Kaggle credentials — create these in Kaggle account settings, never commit them
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

# Kaggle accelerator name supported by your account and current Kaggle API
KAGGLE_ACCELERATOR=NvidiaTeslaT4
KAGGLE_MAX_GPU_NODES=2
KAGGLE_KERNEL_PREFIX=cheatlab-ai-worker

# Model path inside Kaggle (attach a Kaggle Dataset containing the GGUF file)
MODEL_PATH=/kaggle/input/ail-model/model.gguf

# Optional: Pinggy SSH target. Confirm the current target in Pinggy documentation.
PINGGY_SSH_TARGET=a.pinggy.io

NODE_HEARTBEAT_TIMEOUT=45
QUEUE_TIMEOUT_SECONDS=180
MAX_REQUEST_BYTES=10485760
WORKER_URL_SUFFIX=.pinggy.link
AUTO_SCALE_ENABLED=false
