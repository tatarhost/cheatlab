<Window x:Class="CheatLab.WifiStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CHEATLAB Wi-Fi Studio" Width="1120" Height="800"
        MinWidth="900" MinHeight="680"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="CHEATLAB / NETWORK TOOLS" Foreground="{StaticResource MutedBrush}"
                   FontSize="10" FontWeight="Bold"/>
        <TextBlock Text="Wi-Fi Studio" FontSize="30" FontWeight="Bold" Margin="0,5,0,0"/>
        <TextBlock Text="Скорость интернета · эфир Wi-Fi · обратимые настройки адаптера"
                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
              Padding="12,8" VerticalAlignment="Center" CornerRadius="3">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="7" Height="7" Fill="#B9B9B9" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Text="ЛОКАЛЬНОЕ ПРИЛОЖЕНИЕ" FontSize="9" FontWeight="Bold"
                     Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </Border>
    </Grid>

    <TabControl x:Name="MainTabs" Grid.Row="1" Background="{StaticResource PageBrush}"
                BorderBrush="{StaticResource LineBrush}" Foreground="{StaticResource TextBrush}"
                Padding="4">
      <TabItem Header="Скорость интернета" Padding="16,10" Background="#1D1D20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20">
            <TextBlock Text="Проверка соединения" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Измерение проходит через Cloudflare. Для одного теста используется примерно 10 МБ трафика."
                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,18"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="1" Padding="18" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="DOWNLOAD" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                  <TextBlock x:Name="DownloadValue" Text="—" FontSize="34" FontWeight="Bold" Margin="0,10,0,0"/>
                  <TextBlock Text="Мбит/с" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="1" Padding="18" Margin="4,0">
                <StackPanel>
                  <TextBlock Text="UPLOAD" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                  <TextBlock x:Name="UploadValue" Text="—" FontSize="34" FontWeight="Bold" Margin="0,10,0,0"/>
                  <TextBlock Text="Мбит/с" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="1" Padding="18" Margin="8,0,0,0">
                <StackPanel>
                  <TextBlock Text="LATENCY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                  <TextBlock x:Name="LatencyValue" Text="—" FontSize="34" FontWeight="Bold" Margin="0,10,0,0"/>
                  <TextBlock Text="мс" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </StackPanel>
              </Border>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,22,0,8">
              <Button x:Name="SpeedButton" Content="Запустить тест" Style="{StaticResource ActionButton}"
                      Click="SpeedButton_Click" MinWidth="160"/>
              <TextBlock x:Name="SpeedStatus" Text="Готово к проверке" Foreground="{StaticResource MutedBrush}"
                         VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" Padding="14" Margin="0,10,0,0">
              <TextBlock Text="Результат зависит от загруженности сети, расстояния до роутера, частоты Wi-Fi и сервера измерения. Тест отправляет временные данные измерения в Cloudflare; личные файлы не используются."
                         Foreground="{StaticResource MutedBrush}" FontSize="11" LineHeight="18"/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Каналы Wi-Fi" Padding="16,10" Background="#1D1D20">
        <Grid Margin="20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Загруженность радиоэфира" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock x:Name="CurrentWifiText" Text="Нажми «Сканировать», чтобы найти видимые сети."
                         Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="ScanButton" Content="Сканировать" Style="{StaticResource ActionButton}"
                      Click="ScanButton_Click" MinWidth="120"/>
              <Button Content="Открыть настройки роутера" Style="{StaticResource QuietButton}"
                      Click="OpenRouter_Click" Margin="8,0,0,0"/>
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1" Padding="14" Margin="0,16,0,12">
            <StackPanel>
              <TextBlock Text="РЕКОМЕНДАЦИЯ ДЛЯ 2,4 ГГц" Foreground="{StaticResource MutedBrush}"
                         FontSize="9" FontWeight="Bold"/>
              <TextBlock x:Name="RecommendedText" Text="Сначала выполни сканирование."
                         FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
              <TextBlock Text="Считаются только сети, видимые этому компьютеру. Это оценка загруженности, а не измерение помех."
                         Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="2" x:Name="ChannelBarsPanel" Margin="0,0,0,14"/>
          <DataGrid Grid.Row="3" x:Name="NetworksGrid" ItemsSource="{Binding}"
                    AlternationCount="2" MinHeight="180">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Сеть" Binding="{Binding Ssid}" Width="2*"/>
              <DataGridTextColumn Header="Канал" Binding="{Binding Channel}" Width="70"/>
              <DataGridTextColumn Header="Диапазон" Binding="{Binding Band}" Width="100"/>
              <DataGridTextColumn Header="Сигнал" Binding="{Binding Signal, StringFormat={}{0}%}" Width="85"/>
              <DataGridTextColumn Header="BSSID" Binding="{Binding Bssid}" Width="2*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="Настройки адаптера" Padding="16,10" Background="#1D1D20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20">
            <TextBlock Text="Изменения с предпросмотром" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Можно менять только поддерживаемые драйвером параметры Wi-Fi-адаптера. Перед применением приложение сохранит исходное значение."
                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,18"/>
            <TextBlock Text="Wi-Fi-адаптер" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            <ComboBox x:Name="AdapterPicker" DisplayMemberPath="Name" SelectionChanged="AdapterPicker_SelectionChanged"/>
            <TextBlock Text="Параметр драйвера" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,14,0,0"/>
            <ComboBox x:Name="PropertyPicker" DisplayMemberPath="DisplayName" SelectionChanged="PropertyPicker_SelectionChanged"/>
            <TextBlock Text="Новое значение" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,14,0,0"/>
            <ComboBox x:Name="TargetValuePicker" SelectionChanged="TargetValuePicker_SelectionChanged"/>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" Padding="16" Margin="0,18,0,0">
              <StackPanel>
                <TextBlock Text="ПРЕДПРОСМОТР" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold"/>
                <TextBlock x:Name="PreviewText" Text="Выбери адаптер, параметр и значение, затем нажми «Показать изменения»."
                           FontSize="13" Margin="0,9,0,0" LineHeight="21"/>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button Content="Показать изменения" Style="{StaticResource QuietButton}"
                      Click="PreviewButton_Click"/>
              <Button x:Name="ApplyButton" Content="Применить" Style="{StaticResource ActionButton}"
                      Click="ApplyButton_Click" Margin="8,0,0,0" IsEnabled="False"/>
              <Button x:Name="RevertButton" Content="Вернуть все изменения" Style="{StaticResource QuietButton}"
                      Click="RevertButton_Click" Margin="8,0,0,0" IsEnabled="False"/>
            </StackPanel>
            <TextBlock x:Name="SettingsStatus" Text="Загрузка поддерживаемых параметров…"
                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,0"/>
            <Border Background="#181719" BorderBrush="#4A3D32" BorderThickness="1"
                    Padding="13" Margin="0,16,0,0">
              <TextBlock Text="Важно: эта вкладка меняет только параметры локального Wi-Fi-адаптера Windows. Канал точки доступа задаётся в настройках самого роутера; приложение анализирует эфир и открывает его панель, но не пытается менять роутер без поддержки его модели."
                         Foreground="#D6C2A8" FontSize="11" LineHeight="18"/>
            </Border>
            <TextBlock Text="Сохранённые изменения" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,8"/>
            <ItemsControl x:Name="BackupList"/>
            <TextBlock Text="Резервная копия хранится локально в профиле Windows. После изменения параметров может понадобиться переподключение к Wi-Fi."
                       Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="2" Text="CHEATLAB · WI-FI STUDIO · ПАРАМЕТРЫ МЕНЯЮТСЯ ТОЛЬКО ПОСЛЕ ПОДТВЕРЖДЕНИЯ"
               Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="2,12,0,0"/>
  </Grid>
</Window>