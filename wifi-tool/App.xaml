<Application x:Class="CheatLab.WifiStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBrush" Color="#0C0C0D"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#151517"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#1D1D20"/>
    <SolidColorBrush x:Key="LineBrush" Color="#343438"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A2A2A8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#E6E6E6"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="Button" x:Key="ActionButton">
      <Setter Property="Foreground" Value="#111113"/>
      <Setter Property="Background" Value="#F0F0F0"/>
      <Setter Property="BorderBrush" Value="#F0F0F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.985" ScaleY="0.985"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="QuietButton" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="#222225"/>
      <Setter Property="BorderBrush" Value="#414146"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#151517"/>
      <Setter Property="Background" Value="#E8E8E8"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#151517"/>
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="RowBackground" Value="#151517"/>
      <Setter Property="AlternatingRowBackground" Value="#1B1B1E"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#333338"/>
      <Setter Property="BorderBrush" Value="#333338"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
      <Setter Property="CanUserResizeRows" Value="False"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="ColumnHeaderStyle">
        <Setter.Value>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#252529"/>
            <Setter Property="Foreground" Value="#BDBDC3"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="BorderBrush" Value="#3A3A40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="CellStyle">
        <Setter.Value>
          <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#444449"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>